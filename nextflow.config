/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    t2t-flow Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments. Telomere-to-telomere
    de novo genome assembly of non-model organisms from long reads.
----------------------------------------------------------------------------------
*/

// ============================================================================
//  Global default params, used in configs
// ============================================================================
params {

    // -------- Input / output options --------
    input                = null
    outdir               = null
    email                = null
    multiqc_title        = null
    multiqc_config       = null

    // -------- Reference / profiling --------
    kmer_size            = 21
    ploidy               = 2
    genome_size          = null

    // -------- Assembly --------
    assembler            = 'hifiasm'        // hifiasm | verkko | flye
    flye_mode            = '--pacbio-hifi'

    // -------- Purge dups --------
    skip_purgedups       = false
    min_contig_length    = 1000

    // -------- Scaffolding --------
    scaffolder           = 'yahs'           // yahs | salsa
    skip_scaffolding     = false
    hic_enzyme           = null

    // -------- Polishing --------
    run_polishing        = false

    // -------- QC / benchmark --------
    busco_lineage        = 'auto'
    busco_mode           = 'genome'
    busco_db             = null
    skip_busco           = false
    telomere_motif       = 'AACCCT'
    tidk_clade           = null

    // -------- Contamination --------
    skip_readqc          = false
    skip_contamination   = false
    kraken2_db           = null
    contaminant_taxids   = '2,2157,10239'   // Bacteria, Archaea, Viruses
    run_fcs_gx           = false
    fcs_gx_db            = null
    fcs_gx_tax_id        = null

    // -------- Generic / max-resource options --------
    max_cpus             = 16
    max_memory           = '128.GB'
    max_time             = '240.h'

    // -------- nf-schema / validation & boilerplate options --------
    help                 = false
    version              = false
    validate_params      = true
    monochrome_logs      = false
    publish_dir_mode     = 'copy'
    trace_report_suffix  = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

    // -------- Institutional / profile metadata --------
    config_profile_name        = null
    config_profile_description = null
}

// ============================================================================
//  Nextflow plugins
// ============================================================================
plugins {
    id 'nf-schema@2.1.1'
}

// ============================================================================
//  Load base.config (resource labels) by default for all pipeline runs
// ============================================================================
includeConfig 'conf/base.config'

// ============================================================================
//  Profiles
// ============================================================================
profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    docker {
        docker.enabled          = true
        docker.runOptions       = '-u $(id -u):$(id -g)'
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    apptainer {
        // apptainer is the maintained successor to singularity; same depot images.
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        channels                = ['conda-forge', 'bioconda']
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
    lsf {
        includeConfig 'conf/lsf.config'
    }
    awsbatch {
        includeConfig 'conf/awsbatch.config'
    }
    test {
        includeConfig 'conf/test.config'
    }
    test_full {
        includeConfig 'conf/test_full.config'
    }
}

// ============================================================================
//  Module-level config (publishDir, ext.args, ext.prefix)
// ============================================================================
includeConfig 'conf/modules.config'

// ============================================================================
//  Container engine defaults
// ============================================================================
docker.registry      = 'quay.io'
podman.registry      = 'quay.io'
singularity.registry = 'quay.io'
apptainer.registry   = 'quay.io'

// Export these environment variables so the pipeline is reproducible and
// well-behaved inside containers.
env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Capture exit codes from upstream processes when piping.
process.shell = ['/bin/bash', '-euo', 'pipefail']

// ============================================================================
//  Execution reports (timeline / report / trace / dag)
// ============================================================================
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

// ============================================================================
//  Manifest
// ============================================================================
manifest {
    name            = 't2t-flow'
    author          = 'The t2t-flow contributors'
    homePage        = 'https://github.com/t2t-flow/t2t-flow'
    description     = 'Telomere-to-telomere de novo genome assembly of non-model organisms from long reads'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '1.0.0'
    license         = 'GPL-3.0-or-later'
}

// ============================================================================
//  nf-schema validation defaults
// ============================================================================
validation {
    failUnrecognisedParams = false
    lenientMode            = false
    help {
        enabled    = true
        command    = 'nextflow run t2t-flow/t2t-flow -profile docker --input samplesheet.csv --outdir <OUTDIR>'
        fullParameter = 'help_full'
        showHiddenParameter = 'show_hidden'
    }
}

// ============================================================================
//  Resource ceilings are enforced via process.resourceLimits in conf/base.config
//  (Nextflow >= 24.04). The legacy check_max() helper has been removed because
//  function definitions are not permitted in the strict config syntax used by
//  recent Nextflow releases.
// ============================================================================

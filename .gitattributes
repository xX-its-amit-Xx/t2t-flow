# Force LF line endings for every text file so the pipeline runs correctly on
# Linux / macOS executors (containers, HPC, CI) regardless of the contributor's
# OS or local git core.autocrlf setting. CRLF in a process script, a bin/ helper
# shebang, or a YAML/JSON file would break execution on Unix.
* text=auto eol=lf

# Nextflow / shell / python / config are always LF.
*.nf      text eol=lf
*.config  text eol=lf
*.sh      text eol=lf
*.py      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.csv     text eol=lf

# Binary assets: never apply line-ending conversion.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gz   binary
*.bam  binary
*.bai  binary
*.bgz  binary

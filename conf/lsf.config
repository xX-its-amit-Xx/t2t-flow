/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    t2t-flow LSF executor config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Generic IBM LSF (bsub) submission settings. Override `process.queue` and
    `process.clusterOptions` for your site.
----------------------------------------------------------------------------------
*/

process {
    executor = 'lsf'

    // Site-specific default queue.
    queue = 'normal'

    // Placeholder for site-specific bsub flags (projects, resource strings).
    // clusterOptions = '-P YOUR_PROJECT'
}

executor {
    queueSize        = 100
    submitRateLimit  = '10/1min'
    pollInterval     = '30 sec'
    // LSF reports per-core memory by default on many sites; flip if needed.
    perJobMemLimit   = true
}

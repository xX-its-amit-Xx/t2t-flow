/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    t2t-flow AWS Batch executor config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Generic AWS Batch settings. You MUST supply:
      * a working S3 work directory via `-work-dir s3://<bucket>/work` (or workDir below)
      * the JobQueue name via `process.queue`
      * the AWS region via `aws.region`
    These are placeholders; override per deployment.
----------------------------------------------------------------------------------
*/

process {
    executor = 'awsbatch'

    // Name of the AWS Batch JobQueue to submit to (placeholder).
    queue = 'YOUR_AWS_BATCH_JOB_QUEUE'
}

aws {
    // AWS region of the Batch compute environment / S3 bucket (placeholder).
    region = 'us-east-1'

    batch {
        // Path to the aws CLI inside the container image used by AWS Batch.
        cliPath        = '/usr/local/bin/aws'
        maxParallelTransfers = 4
        maxTransferAttempts  = 3
        volumes        = []
    }
}

// NOTE: AWS Batch REQUIRES the Nextflow work directory to live on S3, e.g.
//   nextflow run main.nf -profile awsbatch -work-dir s3://my-bucket/t2tflow/work
// Uncomment and edit to hard-code it:
// workDir = 's3://YOUR_BUCKET/t2tflow/work'

executor {
    queueSize = 100
}

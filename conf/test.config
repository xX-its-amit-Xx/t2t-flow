/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    t2t-flow test profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Minimal-resource parameters for a fast CI run. CI primarily exercises the
    DAG via `nextflow run . -profile test -stub-run` (no containers, stub blocks
    only), so the exact data file is non-blocking, but a real tiny public HiFi
    dataset is referenced for live smoke tests.

    Use as follows:
        nextflow run . -profile test,docker --outdir <OUTDIR>
        nextflow run . -profile test -stub-run --outdir <OUTDIR>
----------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Cap resources so the test runs on a tiny GitHub Actions runner.
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '2.h'

    // Input data (samplesheet you also ship in assets/).
    input = "${projectDir}/assets/samplesheet_test.csv"

    // Profiling / k-mer.
    kmer_size   = 21
    ploidy      = 2
    genome_size = 100000      // ~100 kb toy genome for fast GenomeScope/Merqury

    // Assembly: hifiasm is the default and the fastest path for tiny HiFi reads.
    assembler  = 'hifiasm'
    scaffolder = 'yahs'

    // QC: use the smallest BUSCO lineage for speed.
    busco_lineage = 'bacteria_odb10'
    busco_mode    = 'genome'

    // Telomere search default motif (plant/animal AACCCT works as a placeholder).
    telomere_motif = 'AACCCT'

    // Skip the heavyweight / DB-dependent optional stages for a fast CI run.
    skip_contamination = true
    skip_purgedups     = false
    skip_scaffolding   = false
    run_polishing      = false
    run_fcs_gx         = false
}

process {
    // Hard cap every task to a tiny CI runner. This overrides the params-derived
    // resourceLimits in conf/base.config (which is evaluated eagerly with the
    // production max_* defaults, before this profile lowers them), so heavy
    // withName overrides like HIFIASM (16 cpus) are clamped down here.
    resourceLimits = [ cpus: 2, memory: '6.GB', time: '2.h' ]

    // Disable hifiasm's ~17 GB default bloom filter (-f37) for the tiny dataset.
    withName: 'HIFIASM' { ext.args = '-f0' }
}

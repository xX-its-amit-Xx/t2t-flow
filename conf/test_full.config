/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    t2t-flow test_full profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A "real data" smoke test that downloads a tiny PUBLIC HiFi read set and runs
    the live containers end to end. Unlike `-profile test` (which uses the bundled
    local fixtures in assets/test_data and is meant for the fast, hermetic
    `-stub-run` DAG check), this profile actually executes the tools, so it needs
    a container engine and network access.

    Usage:
        nextflow run . -profile test_full,docker --outdir <OUTDIR>
----------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Tiny public HiFi dataset, live containers (no Hi-C; scaffolding auto-skips)'

    // A small public PacBio HiFi read set (nf-core/test-datasets). Verified 200 OK.
    input = "${projectDir}/assets/samplesheet_test_full.csv"

    // Modest ceilings - still runnable on a laptop / small CI runner.
    max_cpus   = 4
    max_memory = '12.GB'
    max_time   = '4.h'

    kmer_size   = 21
    ploidy      = 2
    genome_size = 100000

    assembler  = 'hifiasm'

    busco_lineage = 'bacteria_odb10'
    busco_mode    = 'genome'

    telomere_motif = 'AACCCT'

    // The public sample is HiFi-only -> no Hi-C, so scaffolding has nothing to do.
    skip_contamination = true
    skip_purgedups     = false
    skip_scaffolding   = true
    run_polishing      = false
    run_fcs_gx         = false
}

process {
    // Concrete cap for the live-container smoke test (overrides the eagerly
    // evaluated, params-derived resourceLimits in conf/base.config).
    resourceLimits = [ cpus: 4, memory: '12.GB', time: '4.h' ]

    // hifiasm's default bloom filter (-f37) pre-allocates ~17 GB irrespective of
    // input size, which OOMs a small CI machine on a tiny dataset. Disable it for
    // the test (production large-genome runs keep the default).
    withName: 'HIFIASM' { ext.args = '-f0' }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    t2t-flow SLURM executor config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Generic SLURM submission settings. Override `process.queue` and
    `process.clusterOptions` for your site (e.g. via a custom -c config).
----------------------------------------------------------------------------------
*/

process {
    executor = 'slurm'

    // Site-specific defaults: adjust the partition/queue name for your cluster.
    queue = 'normal'

    // Placeholder for site-specific sbatch flags (accounts, QOS, constraints).
    // clusterOptions = '--account=YOUR_ACCOUNT --qos=normal'
}

executor {
    // Throttle submission so we do not hammer the scheduler.
    queueSize       = 100
    submitRateLimit = '10/1min'
    pollInterval    = '30 sec'
}

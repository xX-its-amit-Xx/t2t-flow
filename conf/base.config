/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    t2t-flow Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high
    performance compute environments. Assumes that all software is containerized
    and provides generic resource label definitions that scale with task.attempt.

    Resource ceilings are enforced with the modern `process.resourceLimits`
    directive (Nextflow >= 24.04), which automatically clamps each task's
    requested cpus/memory/time to params.max_cpus / max_memory / max_time. This
    replaces the legacy check_max() helper (no longer permitted in the strict
    config syntax of recent Nextflow).
----------------------------------------------------------------------------------
*/

process {

    // Clamp every task's request to the configured ceilings.
    resourceLimits = [
        cpus  : (params.max_cpus   as int),
        memory: (params.max_memory as nextflow.util.MemoryUnit),
        time  : (params.max_time   as nextflow.util.Duration)
    ]

    // Default resources for any process that does not match a label/withName below.
    cpus   = { 1    * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    // Retry on transient / OOM-style exit codes (143=SIGTERM, 137=SIGKILL/OOM,
    // 104=connection reset, 134=SIGABRT, 139=SIGSEGV). Backoff via *task.attempt scaling.
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // ------------------------------------------------------------------------
    // Generic resource labels (referenced by `label` in every module)
    // ------------------------------------------------------------------------
    withLabel:process_single {
        cpus   = { 1 }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel:process_high_memory {
        cpus   = { 12     * task.attempt }
        memory = { 200.GB * task.attempt }
        time   = { 20.h   * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }

    // ------------------------------------------------------------------------
    // Per-process overrides for the heavy assembly / scaffolding stages.
    // These de-novo assemblers are intentionally given the largest resource
    // envelope (still clamped by resourceLimits to max_cpus / max_memory / max_time).
    // ------------------------------------------------------------------------
    withName:HIFIASM {
        cpus   = { 16     * task.attempt }
        memory = { 200.GB * task.attempt }
        time   = { 48.h   * task.attempt }
    }
    withName:VERKKO {
        cpus   = { 16     * task.attempt }
        memory = { 200.GB * task.attempt }
        time   = { 72.h   * task.attempt }
    }
    withName:FLYE {
        cpus   = { 16     * task.attempt }
        memory = { 128.GB * task.attempt }
        time   = { 48.h   * task.attempt }
    }
    withName:YAHS {
        cpus   = { 8     * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withName:SALSA2 {
        cpus   = { 8     * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    t2t-flow module-level configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Sets process-level `ext.args`, `ext.prefix` and per-process `publishDir`.
    Output is organised into numbered stage sub-folders under params.outdir:
        01_readqc  02_contamination  03_assembly  04_purgedups
        05_scaffolding  06_qc  07_release  pipeline_info
----------------------------------------------------------------------------------
*/

process {

    // ------------------------------------------------------------------------
    // Global default publishing behaviour
    // ------------------------------------------------------------------------
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // ========================================================================
    // 01_readqc
    // ========================================================================
    withName:SEQKIT_STATS {
        ext.args   = '-a'
        publishDir = [
            path: { "${params.outdir}/01_readqc/seqkit/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName:NANOPLOT {
        publishDir = [
            path: { "${params.outdir}/01_readqc/nanoplot/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName:MERYL_COUNT {
        publishDir = [
            path: { "${params.outdir}/01_readqc/meryl/${meta.id}" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }
    withName:MERYL_HISTOGRAM {
        publishDir = [
            path: { "${params.outdir}/01_readqc/meryl/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName:GENOMESCOPE2 {
        // ploidy is passed to the module via its typed `val ploidy` input
        // (--ploidy $ploidy in the script); do NOT duplicate it in ext.args.
        publishDir = [
            path: { "${params.outdir}/01_readqc/genomescope2/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ========================================================================
    // 02_contamination
    // ========================================================================
    withName:KRAKEN2 {
        publishDir = [
            path: { "${params.outdir}/02_contamination/kraken2/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName:KRAKENTOOLS_EXTRACT {
        publishDir = [
            path: { "${params.outdir}/02_contamination/clean_reads/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName:FCS_GX {
        publishDir = [
            path: { "${params.outdir}/02_contamination/fcs_gx/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ========================================================================
    // 03_assembly
    // ========================================================================
    withName:HIFIASM {
        ext.args   = ''
        publishDir = [
            path: { "${params.outdir}/03_assembly/hifiasm/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName:VERKKO {
        ext.args   = ''
        publishDir = [
            path: { "${params.outdir}/03_assembly/verkko/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName:FLYE {
        ext.args   = ''
        publishDir = [
            path: { "${params.outdir}/03_assembly/flye/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    // NOTE: GFASTATS is not run inside the ASSEMBLY subworkflow; raw-contig stats
    // are produced by PURGE_DUPS (GFASTATS_BEFORE) and final stats by
    // QC_BENCHMARK (GFASTATS). No 'ASSEMBLY:GFASTATS' selector is defined here
    // because no such process exists in that subworkflow path.

    // ========================================================================
    // 04_purgedups
    // ========================================================================
    withName:'PURGE_DUPS:MINIMAP2_READS' {
        // The -x preset (map-hifi) is supplied via the module's typed `val preset`
        // input from the subworkflow; ext.args carries only extra flags.
        ext.prefix = { "${meta.id}.reads_vs_asm" }
    }
    withName:'PURGE_DUPS:MINIMAP2_SELF' {
        // The -x preset (asm5) is supplied via the module's typed `val preset`
        // input; only the self-alignment-specific -DP flag is added here.
        ext.args   = '-DP'
        ext.prefix = { "${meta.id}.self" }
    }
    withName:'PURGE_DUPS:PURGEDUPS_.*' {
        publishDir = [
            path: { "${params.outdir}/04_purgedups/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName:'PURGE_DUPS:PURGEDUPS_GETSEQS' {
        ext.prefix = { "${meta.id}.purged" }
        publishDir = [
            path: { "${params.outdir}/04_purgedups/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName:'PURGE_DUPS:GFASTATS_BEFORE' {
        ext.prefix = { "${meta.id}.before_purge" }
        publishDir = [
            path: { "${params.outdir}/04_purgedups/${meta.id}/stats" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName:'PURGE_DUPS:GFASTATS_AFTER' {
        ext.prefix = { "${meta.id}.after_purge" }
        publishDir = [
            path: { "${params.outdir}/04_purgedups/${meta.id}/stats" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ========================================================================
    // 05_scaffolding
    // ========================================================================
    withName:SAMTOOLS_FAIDX {
        publishDir = [
            path: { "${params.outdir}/05_scaffolding/faidx/${meta.id}" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }
    withName:CHROMAP_INDEX {
        publishDir = [
            path: { "${params.outdir}/05_scaffolding/chromap/${meta.id}" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }
    withName:CHROMAP {
        // --preset hic is already hardcoded in the CHROMAP module script.
        publishDir = [
            path: { "${params.outdir}/05_scaffolding/chromap/${meta.id}" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }
    withName:'SCAFFOLDING:SAMTOOLS_SORT' {
        ext.args   = '-n'
        ext.prefix = { "${meta.id}.hic.sorted" }
        publishDir = [
            path: { "${params.outdir}/05_scaffolding/hic_alignments/${meta.id}" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }
    withName:YAHS {
        publishDir = [
            path: { "${params.outdir}/05_scaffolding/yahs/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName:SALSA2 {
        // The restriction enzyme (-e) is passed to the SALSA2 module via its typed
        // `val enzyme` input (params.hic_enzyme); do NOT duplicate it in ext.args.
        publishDir = [
            path: { "${params.outdir}/05_scaffolding/salsa2/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ========================================================================
    // 06_qc
    // ========================================================================
    withName:'QC_BENCHMARK:GFASTATS' {
        ext.prefix = { "${meta.id}.final" }
        publishDir = [
            path: { "${params.outdir}/06_qc/gfastats/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName:'QC_BENCHMARK:SAMTOOLS_FAIDX' {
        publishDir = [
            path: { "${params.outdir}/06_qc/faidx/${meta.id}" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }
    withName:QUAST {
        publishDir = [
            path: { "${params.outdir}/06_qc/quast/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName:BUSCO {
        ext.args   = ''
        publishDir = [
            path: { "${params.outdir}/06_qc/busco/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName:MERQURY {
        publishDir = [
            path: { "${params.outdir}/06_qc/merqury/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName:TIDK_EXPLORE {
        // --minimum 5 --maximum 12 are already hardcoded in the TIDK_EXPLORE module.
        publishDir = [
            path: { "${params.outdir}/06_qc/tidk/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName:TIDK_SEARCH {
        // --extension tsv is already hardcoded in the TIDK_SEARCH module.
        publishDir = [
            path: { "${params.outdir}/06_qc/tidk/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName:TIDK_PLOT {
        publishDir = [
            path: { "${params.outdir}/06_qc/tidk/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName:TELOMERE_TABLE {
        publishDir = [
            path: { "${params.outdir}/06_qc/telomere/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ========================================================================
    // Polishing (optional)
    // ========================================================================
    withName:'POLISHING:MINIMAP2_ALIGN' {
        // The -x preset (map-hifi) is supplied via the module's typed `val preset`
        // input from the subworkflow; do not duplicate it in ext.args.
        ext.prefix = { "${meta.id}.polish" }
    }
    withName:RACON {
        publishDir = [
            path: { "${params.outdir}/03_assembly/polished/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ========================================================================
    // 07_release
    // ========================================================================
    withName:ASSEMBLY_STATS_JSON {
        publishDir = [
            path: { "${params.outdir}/07_release/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName:MULTIQC {
        ext.args   = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
        publishDir = [
            path: { "${params.outdir}/07_release/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

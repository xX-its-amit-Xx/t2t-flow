{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/t2t-flow/t2t-flow/master/assets/samplesheet_schema.json",
    "title": "t2t-flow pipeline - params.input samplesheet schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces"
            },
            "hifi": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.(fa|fasta|fa\\.gz|fasta\\.gz|fq|fastq|fq\\.gz|fastq\\.gz)$",
                "errorMessage": "PacBio HiFi reads must be a FASTA/FASTQ file (optionally gzipped)"
            },
            "ont": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.(fa|fasta|fa\\.gz|fasta\\.gz|fq|fastq|fq\\.gz|fastq\\.gz)$",
                "errorMessage": "Oxford Nanopore reads must be a FASTA/FASTQ file (optionally gzipped)"
            },
            "hic_1": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.(fq|fastq|fq\\.gz|fastq\\.gz)$",
                "errorMessage": "Hi-C R1 reads must be a FASTQ file (optionally gzipped)"
            },
            "hic_2": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.(fq|fastq|fq\\.gz|fastq\\.gz)$",
                "errorMessage": "Hi-C R2 reads must be a FASTQ file (optionally gzipped)"
            }
        },
        "required": ["sample"]
    }
}

# EditorConfig is awesome: https://EditorConfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Nextflow / Groovy
[*.{nf,nf.test,config,groovy,gradle}]
indent_style = space
indent_size = 4

# Python
[*.py]
indent_style = space
indent_size = 4

# YAML / JSON
[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

# Markdown: preserve trailing whitespace (significant for line breaks)
[*.md]
trim_trailing_whitespace = false

# Makefiles require tabs
[{Makefile,*.mk}]
indent_style = tab

# Shell scripts
[*.sh]
indent_style = space
indent_size = 4
